{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist",
		"wasm"
	],
	"compilerOptions": {
		"types": ["node", "astro/client", "vite/client"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"paths": {
			"diff-wasm": ["./wasm/diff-wasm/pkg"],
			"diff-wasm/*": ["./wasm/diff-wasm/pkg/*"]
		}
	}
}
