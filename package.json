{
	"name": "node-diff",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build:wasm": "RUST_LOG=info bunx wasm-pack build --target web wasm/diff-wasm",
		"build": "bun run build:wasm && astro build",
		"preview": "astro build && astro preview",
		"astro": "astro",
		"format": "biome format .",
		"lint": "biome lint .",
		"migrate": "biome migrate --write"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/react": "6.0.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"astro": "7.2.4",
		"diff-wasm": "file:./wasm/diff-wasm/pkg",
		"highlight.js": "^11.12.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26",
		"husky": "^9.1.7",
		"tailwindcss": "4.3.3",
		"wasm-pack": "^0.15.0"
	}
}
