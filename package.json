{
	"name": "diffpack",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 4321",
		"build:wasm": "RUST_LOG=info bunx wasm-pack build --target web wasm/diff-wasm",
		"build": "bun run build:wasm && vite build",
		"preview": "vite preview --port 4321",
		"generate-routes": "tsr generate",
		"test": "bun test",
		"test:e2e": "playwright test",
		"lint": "biome lint .",
		"format": "biome format .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui-components/react": "1.0.0-rc.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.31",
		"@tanstack/react-start": "1.168.48",
		"@tanstack/react-store": "0.11.1",
		"@tanstack/react-virtual": "3.14.10",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@playwright/test": "1.62.1",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/router-cli": "1.167.32",
		"@types/bun": "1.3.14",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"husky": "9.1.7",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"wasm-pack": "0.15.0"
	}
}
