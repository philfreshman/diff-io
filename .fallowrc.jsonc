{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

	// `src/lib/worker/diff.worker.ts:6` imports the wasm binary as a URL:
	//   import wasmUrl from "diff-wasm/diff_wasm_bg.wasm?url"
	// `diff-wasm` is an alias declared in `vite.config.ts` (`resolve.alias`)
	// pointing at `wasm/diff-wasm/pkg`, which `bun run build:wasm` generates and
	// which is deliberately NOT a package.json dependency: a `file:` dep breaks
	// `bun install` in toolchain-less environments and breaks Renovate lockfile
	// updates. See the comment on the alias in `vite.config.ts` for the full
	// rationale. fallow does not read Vite aliases, so it is told here.
	//
	// The bare `diff-wasm` specifier on line 5 is NOT listed: #114 added a
	// checked-in declaration at `wasm/diff-wasm/types/diff-wasm.d.ts` and a
	// tsconfig `paths` entry for it, so fallow resolves that one on its own.
	// The `?url` suffix on line 6 is a Vite query, which no tsconfig path can
	// describe — it stays here.
	"ignoreUnresolvedImports": ["diff-wasm/diff_wasm_bg.wasm?url"],

	// `public/` is copied to the site root verbatim; nothing imports it and
	// nothing should. `public/nightfall.css` is fetched at runtime from a string
	// reference in `src/lib/diff/highlightThemes.ts` (`asset: "/nightfall.css"`),
	// so static import-graph reachability is the wrong question to ask of this
	// directory.
	"ignorePatterns": ["public/**"],

	"health": {
		// Decision 1 on #111: CRAP is advisory here, never a gate.
		// `bun test --coverage` emits only text and lcov; fallow wants Istanbul
		// `coverage-final.json`, so every CRAP number in this repo is
		// `static_estimated` — derived from how many places reference an export,
		// not from real coverage. Gating on that means a function starts failing
		// because an unrelated file stopped importing it. The number stays in the
		// report for triage ranking (it is how the #118 refactor priorities were
		// chosen); this ceiling is set out of reach so it cannot block.
		// Revisit only if Playwright V8 coverage gets wired for other reasons.
		"maxCrap": 1000000,

		// Decision 7 on #111, and #118's first task. `scripts/` is dev-only
		// tooling — `capture-screenshots.mjs` and `check-wasm-types.mjs` are run
		// by hand and by CI, and neither is reachable from the app's import
		// graph, so nothing in them can ship. It is stated as intent rather than
		// as a fix: both of the findings it was written for breached on CRAP
		// alone and dropped out when `maxCrap` above was neutralized, so it
		// suppresses nothing today. Note this also takes `scripts/` out of the
		// health *score*, which `thresholdOverrides` below deliberately does not.
		"ignore": ["scripts/**"],

		// Decision 7 on #111: exceptions are per-function numeric ceilings with a
		// reason, never a wider `maxCyclomatic` / `maxCognitive`. A ceiling is set
		// at the function's measured value, so the exception stays a contract —
		// anything added to one of these has to be argued for again rather than
		// sliding under a bar that was left loose.
		"thresholdOverrides": [
			{
				"files": ["src/components/ui/Combobox/Combobox.tsx"],
				"functions": ["Combobox"],
				"maxCognitive": 19,
				// 19 breaks down as 12 points of fallow's prop-count penalty (16
				// props), 4 for its four hooks, and 3 for branching — so a body
				// with no branching in it at all would still score 16, and no
				// refactor of the body can reach the default 15. Only the prop
				// count can, and the prop count is the component: this is the one
				// combobox behind package search and both version selectors, which
				// were three hand-rolled copies with three sets of bugs before it,
				// and each prop is a difference one of those three call sites
				// actually needs. Splitting it back up, or bundling the props into
				// an options object to hide them from the count, would both trade a
				// real property of the code for a number. The nested-ternary filter
				// that was the one genuinely hard part of the body has been lifted
				// out to `resolveFilter`; what is left is the prop list.
				"reason": "16 props on the shared combobox contribute 12 of its 19 cognitive points via fallow's prop-count penalty; branching accounts for 3, so no refactor of the body can reach the default ceiling. The props are the point — one component replaces three hand-rolled copies, and every prop is a difference one of the three call sites needs."
			}
		],
	},

	"rules": {
		// Decision 3 on #111: the warn-tier rules below all report zero findings
		// against the current tree, so promoting them is free today and locks in
		// the clean state. Promoting later, once findings have accumulated, is
		// much harder. If any of these ever goes non-zero, that is a real
		// regression, not a reason to demote it.

		// Dependency hygiene.
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"dev-dependencies-in-production": "error",
		"type-only-dependencies": "error",
		"duplicate-exports": "error",

		// Component-level dead code.
		"unused-store-members": "error",
		"unprovided-injects": "error",
		"unrendered-components": "error",
		"unused-component-props": "error",
		"unused-component-emits": "error",
		"unused-component-inputs": "error",
		"unused-component-outputs": "error",
		"unused-svelte-events": "error",
		"unused-server-actions": "error",
		"unused-load-data-keys": "error",

		// Styling drift.
		"css-token-drift": "error",
		"css-duplicate-block": "error",
		"css-selector-complexity": "error",
		"css-dead-surface": "error",
		"css-broken-reference": "error",

		// Decision 4 on #111: `private-type-leaks` stays off (its default, stated
		// here so the choice is visible). It protects package consumers from
		// exported signatures that reference unexported types. diffpack is an
		// application — nothing imports it — so it is noise with no upside.
		"private-type-leaks": "off",

		// `test-only-dependencies` is deliberately left at its `warn` default and
		// is NOT part of the Decision 3 promotion: it was the one warn-tier rule
		// with a finding (`nitro`), now resolved by moving nitro to
		// devDependencies. Promote it once it has been zero for a while.
	},
}
